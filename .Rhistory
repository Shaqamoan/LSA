protein_anno <- read_csv("../Data/protein_annotation.csv")
head(sample_data, 5)
head(protein_raw, 5)
head(protein_anno, 5)
#1.Dimensies van de datasets controleren
dim(sample_data)
dim(protein_raw)
dim(protein_anno)
#2. Biologische steekproefverdeling
table(sample_data$subject.biologicalSex, dnn = "Geslacht") #aantal mannen en vrouwen
table(sample_data$cmv_status, dnn = "CMV Status") #aantal proefpersonen positief voor CMV en negatief voor CMV
table(sample_data$subject.ageGroup, dnn = "Leeftijdsgroep")#hoeveel proefpersonen in jonge vs oudere leeftijdsgroup
#3.datatypes inspecteren
str(sample_data)
str(protein_raw)
str(protein_anno)
#4.Kwaliteitscontrole: controleren of alle stalen een unieke ID hebben (geen NA's)
sum(is.na(sample_data$sample_kit_id))
sum(is.na(protein_raw$sample_kit_id))
#Aantal missing values (globaal)
colSums(is.na(sample_data))
sum(is.na(sample_data)) #Totaal aantal NA's in de hele tabel
mean(is.na(sample_data))*100 #Algemene percentage lege cellen
missing_metadata <- sample_data %>%
summarise(across(everything(), ~sum(is.na(.)))) %>%
pivot_longer(everything(), names_to = "Variable", values_to = "missing_values") %>%
mutate(Missing_Percentage = (missing_values / nrow(sample_data)) * 100) %>%
arrange(desc(Missing_Percentage))
print(missing_metadata, n = 40)
View(sample_data)
ggplot(
missing_metadata,
aes(x = Missing_Percentage)
) +
geom_histogram(
bins = 20,
fill = "#2E8B57",
colour = "black"
) +
geom_vline(
xintercept = 79,
colour = "red",
linetype = "dashed",
linewidth = 1
) +
theme_bw() +
labs(
title = "Verdeling van ontbrekende waarden in metadata",
x = "% ontbrekende waarden",
y = "Aantal variabelen"
)
# Verwijder metadata-variabelen met meer dan 75% ontbrekende waarden
# Maak een opgeschoonde versie van de metadata
data_clean <- sample_data %>%
select(where(~ mean(is.na(.)) <= 0.75))
