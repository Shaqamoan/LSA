dim(sample_data)
dim(protein_raw)
dim(protein_anno)
table(sample_data$subject.biologicalSex, dnn = "Geslacht") #aantalmannenenvrouwen
table(sample_data$cmv_status, dnn = "CMV Status") #aantalproefpersonenposandneg
table(sample_data$subject.ageGroup, dnn = "Leeftijdsgroep")
#datatypes inspecteren
str(sample_data)
str(protein_raw)
str(protein_anno)
View(protein_anno)
table(protein_ano$pct_below_lod > 20)
table(protein_anno$pct_below_lod > 20)
table(protein_anno$pct_below_lod > 20)
hist(protein_anno$pct_below_lod)
na_per_sample <- rowSums(is.na(sample_data))
hist(
na_per_sample,
breaks = 20,
col = "steelblue",
main = "Aantal ontbrekende waarden per staal",
xlab = "Aantal NA's",
ylab = "Aantal stalen"
)
abline(v = 11, col = "red", lwd = 2)
na_per_sample <- rowSums(is.na(sample_data))
hist(
na_per_sample,
breaks = 20,
col = "steelblue",
main = "Aantal ontbrekende waarden per staal",
xlab = "Aantal NA's",
ylab = "Aantal stalen"
)
abline(v = 11, col = "red", lwd = 2)
boxplot(
rowSums(is.na(sample_data)),
main = "Aantal NA's per staal",
ylab = "Aantal NA's",
col = "lightblue"
)
summary(rowSums(is.na(sample_data)))
colSums(is.na(sample_data))
colSums(is.na(sample_data))
barplot(
colSums(is.na(sample_data)),
horiz = TRUE,
las = 1,
col = "steelblue",
main = "Aantal ontbrekende waarden per variabele",
xlab = "Aantal NA's"
)
#Aantal missing values
colSums(is.na(sample_data))
#filter stalen met te veel NA's in de metadata
data_clean <- sample_data[rowSums(is.na(sample_data)) <= 11, ]
data_clean
colSums(is.na(data_clean))
#filter metadata-kolommen die meer dan 79% ontbrekende waarden vertonen
data_clean <- data_clean[, colMeans(is.na(data_clean)) <= 0.79]
#verwijderen niet-informatieve kolommen
data_clean <- data_clean %>%
select(-subject.race,-subject.ethnicity,-olink_batch_id)
View(sample_data)
View(protein_raw)
View(protein_anno)
View(sample_data)
#Aantal missing values
colSums(is.na(protein_anno))
#1. Bekijk welke eiwitten meer dan 20% onder de detectiegrens liggen
ruis_eiwitten <- protein_anno %>%
filter(pct_below_lod > 20) %>%
pull(protein)
#1.Controle op dubbele eiwitnamen
names(protein_raw)[duplicated(names(protein_raw))]
protein_raw_numeric <- protein_raw[, -1]
outliers <- lapply(protein_raw, function(x) {
Q1 <- quantile(x, 0.25, na.rm = TRUE)
Q3 <- quantile(x, 0.75, na.rm = TRUE)
IQR <- Q3 - Q1
which(x < (Q1 - 1.5 * IQR) |
x > (Q3 + 1.5 * IQR))
})
#1.Controle op dubbele eiwitnamen
names(protein_raw)[duplicated(names(protein_raw))]
protein_raw_numeric <- protein_raw[, -1]
outliers <- lapply(protein_raw_numeric, function(x) {
Q1 <- quantile(x, 0.25, na.rm = TRUE)
Q3 <- quantile(x, 0.75, na.rm = TRUE)
IQR <- Q3 - Q1
which(x < (Q1 - 1.5 * IQR) |
x > (Q3 + 1.5 * IQR))
})
npx_only <- protein_raw_numeric
protein_stats <- data.frame(
protein = colnames(npx_only),
min = apply(npx_only, 2, min, na.rm = TRUE),
max = apply(npx_only, 2, max, na.rm = TRUE),
mean = apply(npx_only, 2, mean, na.rm = TRUE),
sd = apply(npx_only, 2, sd, na.rm = TRUE)
)
head(protein_stats)
