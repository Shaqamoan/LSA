knitr::opts_chunk$set(echo = TRUE)
#Benodige pakketten inladen
library(tidyverse)
#Data inlezen
sample_data <- read_csv("../Data/sample_metadata.csv")
protein_raw <-read_csv("../Data/proteins_npx_raw.csv")
protein_anno <- read_csv("../Data/protein_annotation.csv")
head(sample_data, 5)
head(protein_raw, 5)
head(protein_anno, 5)
#Dimensies van de datasets controleren
dim(sample_data)
dim(protein_raw)
dim(protein_anno)
table(sample_data$subject.biologicalSex, dnn = "Geslacht") #aantal mannen en vrouwen
table(sample_data$cmv_status, dnn = "CMV Status") #aantal proefpersonen positief voor CMV en negatief voor CMV
table(sample_data$subject.ageGroup, dnn = "Leeftijdsgroep")#hoeveel proefpersonen injonge vs oudere leeftijdsgroup
#datatypes inspecteren
str(sample_data)
str(protein_raw)
str(protein_anno)
#1.Controle op dubbele eiwitnamen
names(protein_raw)[duplicated(names(protein_raw))]
#2.Enkel numerieke NPX-kolommen behouden
protein_raw_numeric <- protein_raw[, -1]
#3. Outlierdetectie per eiwit
outliers <- lapply(protein_raw_numeric, function(x) {
Q1 <- quantile(x, 0.25, na.rm = TRUE)
Q3 <- quantile(x, 0.75, na.rm = TRUE)
IQR <- Q3 - Q1
which(x < (Q1 - 1.5 * IQR) |
x > (Q3 + 1.5 * IQR))
})
#4.Beschrijven statistieken per eiwit
protein_stats <- data.frame(
protein = colnames(npx_only),
min = apply(npx_only, 2, min, na.rm = TRUE),
max = apply(npx_only, 2, max, na.rm = TRUE),
mean = apply(npx_only, 2, mean, na.rm = TRUE),
sd = apply(npx_only, 2, sd, na.rm = TRUE)
)
head(protein_stats)
#all_values <- unlist(protein_raw_numeric[,-1])
#boxplot(all_values,
#        horizontal =TRUE,
#       main = "Distribution of NPX values")
#1.Histogrammen
set.seed(123)
selected <- sample(colnames(protein_raw)[-1], 20)
plot_data <- protein_raw %>%
select(all_of(selected)) %>%
pivot_longer(
cols = everything(),
names_to = "Protein",
values_to = "NPX"
)
ggplot(plot_data, aes(x = NPX)) +
geom_histogram(
bins = 30,
fill = "steelblue",
color = "black"
) +
facet_wrap(~Protein, ncol = 5) +
theme_bw() +
labs(
title = "Distribution of 20 randomly selected proteins",
x = "NPX value",
y = "Count"
)
#2. QQ-plots
set.seed(123)
selected <- sample(colnames(protein_raw_numeric), 20)
par(mfrow = c(2,3))
for(prot in selected){
qqnorm(protein_raw_numeric[[prot]],
main = prot)
qqline(protein_raw_numeric[[prot]],
col = "red")
}
