col = "darkgreen",
xlab = pc1_label,
ylab = pc2_label,
main = "PCA van de proteomicsdata"
)
plot(
pca$x[,1],
pca$x[,2],
col = as.factor(metadata_pca$olink_batch_id),
pch = 16,
main = "PCA volgens Olink batch"
)
plot(
pca$x[,1],
